# Copy this file to .env and fill in your values:
#   cp .env.example .env      (`make up` does it automatically if .env is missing)
#
# Never commit .env — it is listed in .gitignore.
# Defaults below match docker-compose.dev.yaml (local only).

# --- Bluesky Jetstream ---
JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe

# --- Redpanda ---
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# --- Garage / S3 ---
# Local-only values for docker-compose.dev.yaml (never reuse them in production).
# Garage key format: ID = "GK" + 24 hex chars, secret = 64 hex chars.
S3_ENDPOINT_URL=http://localhost:3900
AWS_ACCESS_KEY_ID=GK5bee8569ddc8ca86440f1eea
AWS_SECRET_ACCESS_KEY=b4be27e96e1627864faaf60b5361511491b621c9b0a3dd79ca26cf07e4f0f8e0
# Garage enforces the S3 region: read by both s3fs/botocore and DuckDB httpfs
AWS_DEFAULT_REGION=us-east-1
BUCKET=bluesky-streamhouse
# 64 hex chars (openssl rand -hex 32)
GARAGE_RPC_SECRET=acff3bb69d6af6899f4239b3797b1e300222b50f592bdff111bbf8b247f7db78

# --- Postgres (DuckLake catalog + Dagster storage) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=streamhouse
POSTGRES_PASSWORD=streamhouse
DUCKLAKE_CATALOG_DB=ducklake_catalog

# --- Serving API (phase 8) ---
API_KEY=change_me

# --- Failure alerts (phase 3) ---
RESEND_API_KEY=
ALERT_EMAIL=
